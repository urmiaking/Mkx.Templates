@attribute [Route(ClientRoutes.Accounts.ForgotPassword)]
@layout EmptyBoxLayout

<PageTitle>بازیابی رمز عبور</PageTitle>
<div class="identity-brand"><BrandLockup /></div>
<header class="identity-heading">
    <h1>@(Input.Step switch { 2 => "تأیید شماره موبایل", 3 => "تنظیم رمز عبور جدید", 4 => "رمز عبور تغییر کرد", _ => "بازیابی رمز عبور" })</h1>
    <p>@(Input.Step switch { 2 => "کد شش‌رقمی ارسال‌شده به موبایل خود را وارد کنید.", 3 => "یک رمز عبور امن و جدید برای حساب خود انتخاب کنید.", 4 => "اکنون می‌توانید با رمز عبور جدید وارد سامانه شوید.", _ => "شماره موبایل تأییدشده حساب خود را وارد کنید تا کد بازیابی برایتان ارسال شود." })</p>
</header>

@if (Input.Step == 4)
{
    <section class="identity-success"><UiIcon Icon="check-circle" /><p>رمز عبور شما با موفقیت تغییر یافت.</p><a class="ui-button ui-button-filled identity-submit" href="@ClientRoutes.Accounts.Login">ورود به سامانه <UiIcon Icon="forward" /></a></section>
}
else
{
    <EditForm class="identity-form" Model="Input" method="post" OnSubmit="HandleSubmit" FormName="forgotPassword">
        <input type="hidden" name="Input.Step" value="@Input.Step" />
        @if (Input.Step > 1) { <input type="hidden" name="Input.PhoneNumber" value="@Input.PhoneNumber" /> }
        @if (Input.Step > 2) { <input type="hidden" name="Input.OtpCode" value="@Input.OtpCode" /> }
        @if (Input.Step == 1)
        {
            <div>
                <label class="sms-login-label" for="recovery-phone">شماره تلفن همراه</label>
                <div class="sms-login-phonefield"><UiIcon Icon="phone" /><input id="recovery-phone" name="Input.PhoneNumber" value="@Input.PhoneNumber" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="13" required dir="ltr" placeholder="0912 345 6789" /></div>
            </div>
            <button class="sms-login-primary" type="submit" name="Input.Action" value="request" data-otp-request><span data-otp-request-label>ارسال کد بازیابی</span><UiIcon Icon="forward" /><span class="sms-request-spinner" aria-hidden="true"></span></button>
        }
        else if (Input.Step == 2)
        {
            <div class="identity-code-intro">شماره <bdi dir="ltr">@MaskPhone(Input.PhoneNumber)</bdi><a href="@ClientRoutes.Accounts.ForgotPassword">تغییر شماره</a></div>
            <UiOtpField Name="Input.OtpCode" Label="کد شش رقمی بازیابی" AutoSubmit="true" Hint="پس از واردکردن شش رقم، کد به‌صورت خودکار بررسی می‌شود." />
            <button class="sms-login-primary" type="submit" name="Input.Action" value="verify" data-otp-submit>تأیید کد <UiIcon Icon="forward" /></button>
            <div class="sms-login-resend"><button type="submit" class="sms-login-resend-button" name="Input.Action" value="resend" formnovalidate disabled="@(_resendSeconds > 0)" data-otp-resend-seconds="@_resendSeconds"><UiIcon Icon="history" /><span data-otp-resend-label>ارسال مجدد کد</span><span data-otp-resend-count class="sms-resend-count" dir="ltr" aria-live="off">@(_resendSeconds > 0 ? $"{_resendSeconds / 60:00}:{_resendSeconds % 60:00}" : "")</span></button></div>
        }
        else if (Input.Step == 3)
        {
            <label class="ui-field"><span>رمز عبور جدید</span><input name="Input.NewPassword" type="password" autocomplete="new-password" dir="ltr" minlength="12" required /></label>
            <label class="ui-field"><span>تکرار رمز عبور جدید</span><input name="Input.ConfirmPassword" type="password" autocomplete="new-password" dir="ltr" minlength="12" required /></label>
            <button class="ui-button ui-button-filled identity-submit" type="submit" name="Input.Action" value="reset">ذخیره رمز عبور جدید <UiIcon Icon="forward" /></button>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <div class="identity-message error" role="alert">@_errorMessage</div> }
        @if (!string.IsNullOrWhiteSpace(_infoMessage)) { <div class="identity-message" role="status">@_infoMessage</div> }
    </EditForm>
    <a class="sms-login-secondary" href="@ClientRoutes.Accounts.Login"><UiIcon Icon="back" />بازگشت به صفحه ورود</a>
}
