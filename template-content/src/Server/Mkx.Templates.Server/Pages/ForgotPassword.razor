@attribute [Route(ClientRoutes.Accounts.ForgotPassword)]
@layout EmptyBoxLayout

<PageTitle>بازیابی رمز عبور</PageTitle>

<MudStack AlignItems="AlignItems.Center">
    <span class="brand-text" dir="ltr">Mkx.Templates</span>
    <MudText Typo="Typo.body1">بازیابی رمز عبور</MudText>
</MudStack>

<EditForm Model="Input" method="post" OnValidSubmit="HandleSubmit" FormName="forgotPassword">
    <input type="hidden" name="Input.Step" value="@Input.Step" />
    @if (Input.Step > 1)
    {
        <input type="hidden" name="Input.PhoneNumber" value="@Input.PhoneNumber" />
    }
    @if (Input.Step > 2)
    {
        <input type="hidden" name="Input.OtpCode" value="@Input.OtpCode" />
    }

    <MudGrid Spacing="4" Class="mt-2">
        @if (Input.Step == 1)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2 text-center">
                    لطفاً شماره تلفن همراه خود را وارد کنید تا کد تایید ارسال شود.
                </MudText>
                <MudStaticTextField For="@(() => Input.PhoneNumber)" @bind-Value="Input.PhoneNumber"
                                    Label="شماره تلفن همراه" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    UserAttributes="@(new Dictionary<string, object?> { { "dir", "ltr" }, { "inputmode", "numeric" } })" />
            </MudItem>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudItem xs="12" Class="mb-0">
                    <StatusMessage Message="@_errorMessage" Severity="Severity.Error" />
                </MudItem>
            }

            <MudItem xs="12" Class="mt-2">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                 FormAction="FormAction.Submit">
                    ارسال کد تایید
                </MudStaticButton>
            </MudItem>
        }
        else if (Input.Step == 2)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2 text-center">
                    کد تایید ۶ رقمی فرستاده شده به شماره @Input.PhoneNumber را وارد کنید.
                </MudText>
                <MudStaticTextField For="@(() => Input.OtpCode)" @bind-Value="Input.OtpCode"
                                    Label="کد تایید" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    UserAttributes="@(new Dictionary<string, object?> { { "dir", "ltr" }, { "inputmode", "numeric" } })" />
            </MudItem>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudItem xs="12" Class="mb-0">
                    <StatusMessage Message="@_errorMessage" Severity="Severity.Error" />
                </MudItem>
            }

            <MudItem xs="12" Class="mt-2">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                 FormAction="FormAction.Submit">
                    تایید کد
                </MudStaticButton>
            </MudItem>
        }
        else if (Input.Step == 3)
        {
            <MudItem xs="12">
                <MudStaticTextField For="@(() => Input.NewPassword)" @bind-Value="Input.NewPassword"
                                    Label="رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    UserAttributes="@(new Dictionary<string, object?> { { "dir", "ltr" } })" />
            </MudItem>
            <MudItem xs="12">
                <MudStaticTextField For="@(() => Input.ConfirmPassword)" @bind-Value="Input.ConfirmPassword"
                                    Label="تکرار رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    UserAttributes="@(new Dictionary<string, object?> { { "dir", "ltr" } })" />
            </MudItem>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudItem xs="12" Class="mb-0">
                    <StatusMessage Message="@_errorMessage" Severity="Severity.Error" />
                </MudItem>
            }

            <MudItem xs="12" Class="mt-2">
                <MudStaticButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                 FormAction="FormAction.Submit">
                    تغییر رمز عبور
                </MudStaticButton>
            </MudItem>
        }
        else if (Input.Step == 4)
        {
            <MudItem xs="12">
                <StatusMessage Message="رمز عبور شما با موفقیت تغییر یافت." Severity="Severity.Success" />
            </MudItem>
            <MudItem xs="12" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Href="@ClientRoutes.Accounts.Login">
                    ورود به سامانه
                </MudButton>
            </MudItem>
        }

        @if (Input.Step < 4)
        {
            <MudItem xs="12" Class="d-flex justify-center mt-2">
                <a href="@ClientRoutes.Accounts.Login" class="mud-typography mud-link mud-primary-text mud-link-underline-hover mud-typography-body2">بازگشت به صفحه ورود</a>
            </MudItem>
        }
    </MudGrid>
</EditForm>
