@attribute [Route(ClientRoutes.Accounts.Login)]
@layout EmptyBoxLayout

<PageTitle>ورود به سامانه</PageTitle>
<div class="identity-brand"><BrandLockup /></div>
<header class="identity-heading"><h1>ورود به سامانه</h1><p>برای ادامه، اطلاعات حساب خود را وارد کنید.</p></header>

<EditForm class="identity-form" Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
    @if (_options.AllowLocal)
    {
        <label class="ui-field"><span>نام کاربری / شماره تلفن همراه</span><InputText @bind-Value="Input.Username" autocomplete="username" required dir="ltr" /></label>
        <label class="ui-field"><span>رمز عبور</span><InputText @bind-Value="Input.Password" type="password" autocomplete="current-password" required dir="ltr" /></label>
        <div class="identity-options">
            @if (_options.ShowRememberMe) { <label class="ui-checkbox"><InputCheckbox @bind-Value="Input.RememberMe" />مرا به خاطر بسپار</label> }
            <a href="@ClientRoutes.Accounts.ForgotPassword">رمز عبور را فراموش کرده‌اید؟</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <StatusMessage Message="@_errorMessage" Severity="Severity.Error" /> }
        <div class="d-flex align-center gap-2">
            <button class="ui-button ui-button-filled identity-submit" type="submit">ورود <UiIcon Icon="forward" /></button>
            <div id="passkey-login-section" style="display:none"><PasskeySubmit Name="Input.Passkey" Auto="true" Username="Input.Username" /></div>
        </div>
    }
</EditForm>
@if (_options.AllowExternal)
{
    <div class="identity-divider"></div>
    <ExternalLoginPicker AutoRedirect="@(!_options.AllowLocal)" />
}
<script>
    function initPasskeyAutoOpen() {
        const containerId = 'passkey-login-section';
        const storageKey = 'DeviceRegisteredPasskey';
        const container = document.getElementById(containerId);

        if (!container) return;

        const isRegistered = localStorage.getItem(storageKey) === 'true';

        if (isRegistered) {
            container.style.display = 'flex';
            customElements.whenDefined('passkey-submit').then(() => {
                const passkeyComponent = container.querySelector('passkey-submit');

                if (passkeyComponent && typeof passkeyComponent.obtainAndSubmitCredential === 'function') {
                    if (!passkeyComponent.hasAttribute('data-auto-triggered')) {
                        passkeyComponent.setAttribute('data-auto-triggered', 'true');
                        console.log("Auto-triggering passkey modal...");
                        passkeyComponent.obtainAndSubmitCredential(false);
                    }
                }
            });
        }
    }

    initPasskeyAutoOpen();

    if (typeof Blazor !== 'undefined') {
        Blazor.removeEventListener('enhancedload', initPasskeyAutoOpen);
        Blazor.addEventListener('enhancedload', initPasskeyAutoOpen);
    }
</script>
