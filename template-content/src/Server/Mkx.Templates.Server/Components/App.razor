@inject IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563EB" />
    <base href="/" />
     
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="icon-512.png" />

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["Mkx.Templates.Server.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />

    <ImportMap />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    @if (ShowSplash)
    {
        <div id="app-loading">
            <div class="splash-screen">
                <span class="brand-text" dir="ltr">Mkx.Templates</span>
                <div class="splash-progress-track">
                    <div class="splash-progress-bar"></div>
                </div>
            </div>
        </div>
    }

    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    @if (!Env.IsDevelopment())
    {
        <script src="@Assets["js/pwa-helper.js"]"></script>
    }
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/webauthn.js"]"></script>
</body>

</html>