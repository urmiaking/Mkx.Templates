@inject AuthenticationStateProvider AuthState

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (ClientAuthState is { HasConnectionError: true } clientAuthState)
                {
                    <div class="ui-alert ui-alert-warning" role="status">بررسی نشست ممکن نشد. اتصال خود را بررسی کنید.</div>
                    <UiButton OnClick="clientAuthState.RefreshAsync">تلاش مجدد</UiButton>
                }
                else { <HandleNotAuthorized /> }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="#main-content" />
    </Found>
</Router>

@code {
    // Routes also renders static SSR account pages, where the server owns auth state.
    private Mkx.Templates.Client.Common.PersistentAuthenticationStateProvider? ClientAuthState =>
        AuthState as Mkx.Templates.Client.Common.PersistentAuthenticationStateProvider;
}
