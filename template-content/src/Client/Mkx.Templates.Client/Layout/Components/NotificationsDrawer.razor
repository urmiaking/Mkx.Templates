@inherits AppComponentBase
<MudDrawer Open="IsOpen" OpenChanged="IsOpenChanged" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="0" Class="notifications-drawer" role="dialog" aria-modal="true" aria-label="اعلان‌ها" aria-hidden="@(IsOpen ? "false" : "true")">
    <MudFocusTrap Disabled="@(!IsOpen)" DefaultFocus="DefaultFocus.FirstChild">
        @if (IsOpen)
        {
            <div @onkeydown="HandleKeyDown">
                <div class="pa-4 d-flex align-center justify-space-between">
                    <MudText Typo="Typo.h6">اعلان‌ها</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="بستن اعلان‌ها" OnClick="Close" />
                </div>
                <MudText Class="pa-6 text-center" Color="Color.Secondary">هیچ اعلانی دریافت نشده است.</MudText>
            </div>
        }
    </MudFocusTrap>
</MudDrawer>
