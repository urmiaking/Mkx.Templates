<div class="mobile-nav-container @Class" aria-label="ناوبری اصلی موبایل">
    <nav class="mobile-nav-bar" aria-label="ناوبری اصلی">
        <NavLink href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All" class="mobile-nav-item">
            <span class="mobile-nav-icon-wrapper"><MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Medium" /></span>
            <span class="mobile-nav-label">خانه</span>
        </NavLink>

        <NavLink href="@ClientRoutes.Tests.Index" class="mobile-nav-item">
            <span class="mobile-nav-icon-wrapper"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Medium" /></span>
            <span class="mobile-nav-label">تست‌ها</span>
        </NavLink>

        <AuthorizeView Policy="@AppPolicies.Users.View">
            <NavLink href="@ClientRoutes.Users.Index" class="mobile-nav-item">
                <span class="mobile-nav-icon-wrapper"><MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Medium" /></span>
                <span class="mobile-nav-label">کاربران</span>
            </NavLink>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <NavLink href="@ClientRoutes.UserAccounts.Index" class="mobile-nav-item">
                    <span class="mobile-nav-icon-wrapper"><MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Medium" /></span>
                    <span class="mobile-nav-label">حساب من</span>
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <a href="@ClientRoutes.Accounts.Login" class="mobile-nav-item">
                    <span class="mobile-nav-icon-wrapper"><MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Medium" /></span>
                    <span class="mobile-nav-label">ورود</span>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Parameter] public string? Class { get; set; }
}
