@using System.Security.Claims
@inject AuthenticationStateProvider Authentication
<a class="workspace-avatar @Class" href="@Href" aria-label="@AccessibleName" title="@DisplayName">@Initials</a>
@if (ShowDetails)
{
    <div class="workspace-profile-copy"><strong>@DisplayName</strong><small>@UserName</small></div>
}
@code {
    [Parameter] public bool ShowDetails { get; set; }
    [Parameter] public string? Class { get; set; }
    private bool _authenticated;
    private string DisplayName = "کاربر مهمان";
    private string UserName = "برای ادامه وارد شوید";
    private string Initials = "م";
    private string Href => _authenticated ? ClientRoutes.UserAccounts.Index : ClientRoutes.Accounts.Login;
    private string AccessibleName => _authenticated ? "حساب کاربری من" : "ورود به حساب";
    protected override async Task OnInitializedAsync()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _authenticated = user.Identity?.IsAuthenticated == true;
        if (!_authenticated) return;
        DisplayName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "حساب کاربری";
        UserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "حساب شخصی";
        Initials = string.Concat(DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(part => part[0]));
    }
}
