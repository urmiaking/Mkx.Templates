@using System.Globalization
@inject ThemeService Theme
@implements IDisposable

<header class="workspace-topbar">
    <div class="workspace-appbar-leading">
        <div class="workspace-appbar-brand">
            <button type="button" class="workspace-menu-toggle workspace-icon-button"
                    aria-label="باز کردن منوی اصلی" aria-controls="workspace-navigation"
                    aria-expanded="@DrawerOpen.ToString().ToLowerInvariant()" @onclick="OnMenuRequested">
                <UiIcon Icon="menu" />
            </button>
            <a class="workspace-appbar-mark" href="@ClientRoutes.Home.Index" aria-label="صفحه اصلی">
                <BrandLockup Compact="true" ShowCopy="false" />
            </a>
        </div>
        <div class="workspace-appbar-route"><RouteBreadcrumbs /></div>
    </div>
    <a class="workspace-appbar-wordmark" href="@ClientRoutes.Home.Index">
        <BrandLockup Compact="true" ShowMark="false" />
    </a>
    <div class="workspace-appbar-end">
        <div class="workspace-topbar-actions">
@*#if (IncludeSample)*@
            <AuthorizeView Policy="@AppPolicies.SampleItems.View">
                <a class="workspace-icon-button workspace-search" href="@ClientRoutes.SampleItems.Index" aria-label="جستجو در اطلاعات">
                    <UiIcon Icon="search" />
                </a>
            </AuthorizeView>
@*#endif*@
            <button type="button" @ref="_themeButton" class="workspace-icon-button"
                    aria-label="@(Theme.IsDarkMode ? "فعال‌سازی حالت روشن" : "فعال‌سازی حالت تاریک")"
                    aria-pressed="@Theme.IsDarkMode.ToString().ToLowerInvariant()" disabled="@_themeChanging" @onclick="ToggleThemeAsync">
                <UiIcon Icon="@(Theme.IsDarkMode ? "sun" : "moon")" />
            </button>
            <button type="button" class="workspace-icon-button" aria-label="اعلان‌ها" aria-haspopup="dialog" @onclick="OnNotificationsRequested">
                <UiIcon Icon="bell" />
            </button>
            <WorkspaceIdentity Class="workspace-top-avatar" />
        </div>
        <span class="workspace-date"><UiIcon Icon="calendar" />@Today</span>
    </div>
</header>

@code {
    [Parameter] public bool DrawerOpen { get; set; }
    [Parameter] public EventCallback OnMenuRequested { get; set; }
    [Parameter] public EventCallback OnNotificationsRequested { get; set; }

    private ElementReference _themeButton;
    private bool _themeChanging;
    private static string Today => DateTime.Now.ToString("dddd، yyyy/MM/dd", CultureInfo.GetCultureInfo("fa-IR"));

    protected override void OnInitialized() => Theme.OnToggleMode += AppearanceChanged;

    private void AppearanceChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleThemeAsync()
    {
        if (_themeChanging) return;
        _themeChanging = true;
        try { await Theme.ToggleModeAsync(_themeButton); }
        finally { _themeChanging = false; }
    }

    public void Dispose() => Theme.OnToggleMode -= AppearanceChanged;
}
