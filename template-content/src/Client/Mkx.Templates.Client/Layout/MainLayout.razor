@inherits LayoutComponentBase
@implements IDisposable
@layout BaseLayout

<MudLayout>
    <AppBar @bind-DrawerOpen="_drawerOpen" @bind-NotificationsOpen="_notificationsOpen" />
    <Drawer @bind-IsDrawerOpen="_drawerOpen" />
    <NotificationsDrawer @bind-IsOpen="_notificationsOpen" />
    <MudMainContent Class="mt-10 mb-md-4 mb-20 pa-md-4 py-4">
        <div class="page-transition" @key="_currentUri">
            @Body
        </div>
        <MobileNav Class="d-md-none d-flex" />
    </MudMainContent>
</MudLayout>

@code
{
    private bool _drawerOpen = false;
    private bool _notificationsOpen = false;
    private string _currentUri = string.Empty;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        _currentUri = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentUri = e.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}