@inherits LayoutComponentBase
@layout BaseLayout

<div class="workspace-shell" dir="rtl">
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    @if (_mobileMenuOpen)
    {
        <button type="button" class="workspace-menu-scrim" tabindex="-1" aria-label="بستن منوی اصلی" @onclick="CloseMenu"></button>
    }
    <aside id="workspace-navigation" @ref="_sidebar" class="workspace-sidebar @(_mobileMenuOpen ? "mobile-open" : "")" aria-label="ناوبری اصلی" @onkeydown="MenuKeyDown">
        <button type="button" class="workspace-menu-close workspace-icon-button" aria-label="بستن منو" @onclick="CloseMenu"><UiIcon Icon="close" /></button>
        <a class="workspace-brand" href="@ClientRoutes.Home.Index" @onclick="CloseMenu"><BrandLockup /></a>

@*#if (IncludeSample)*@
<AuthorizeView Policy="@AppPolicies.SampleItems.Manage">
            <a class="workspace-create ui-button ui-button-filled" href="@ClientRoutes.SampleItems.Create" @onclick="CloseMenu"><UiIcon Icon="plus" />ثبت مورد جدید</a>
        </AuthorizeView>
@*#endif*@

        <div class="workspace-menu-scroll" @onclick="CloseMenu"><WorkspaceNavigation /></div>
        <NavigationAppearance />
        <div class="workspace-sidebar-bottom"><WorkspaceIdentity ShowDetails="true" /></div>
        <AuthorizeView><div class="workspace-sidebar-signout"><LogoutControl /></div></AuthorizeView>
    </aside>

    <div class="workspace-content">
        <AppBar DrawerOpen="_mobileMenuOpen" OnMenuRequested="OpenMenu" OnNotificationsRequested="OpenNotifications" />
        <main id="main-content" class="workspace-main" tabindex="-1">@Body</main>
    </div>

    <nav class="workspace-bottom-nav" aria-label="ناوبری موبایل">
        <NavLink href="@ClientRoutes.Home.Index" Match="NavLinkMatch.All"><UiIcon Icon="home" /><span>خانه</span></NavLink>

@*#if (IncludeSample)*@
<AuthorizeView Policy="@AppPolicies.SampleItems.View"><NavLink href="@ClientRoutes.SampleItems.Index" Match="NavLinkMatch.All"><UiIcon Icon="list" /><span>نمونه‌ها</span></NavLink></AuthorizeView>
@*#endif*@


@*#if (IncludeSample)*@
<AuthorizeView Policy="@AppPolicies.SampleItems.Manage">
            <Authorized><NavLink class="workspace-bottom-create" href="@ClientRoutes.SampleItems.Create"><span class="workspace-create-circle"><UiIcon Icon="plus" /></span><span>ثبت جدید</span></NavLink></Authorized>
            <NotAuthorized><a class="workspace-bottom-create" href="@ClientRoutes.UserAccounts.Index"><span class="workspace-create-circle"><UiIcon Icon="user" /></span><span>حساب من</span></a></NotAuthorized>
        </AuthorizeView>
@*#else*@
        @if (!IncludesSample)
        {
            <a class="workspace-bottom-create" href="@ClientRoutes.UserAccounts.Index"><span class="workspace-create-circle"><UiIcon Icon="user" /></span><span>حساب من</span></a>
        }
@*#endif*@

        <AuthorizeView Policy="@AppPolicies.Users.View"><NavLink href="@ClientRoutes.Users.Index"><UiIcon Icon="users" /><span>کاربران</span></NavLink></AuthorizeView>
        <AuthorizeView>
            <Authorized><NavLink href="@ClientRoutes.UserAccounts.Index" Match="NavLinkMatch.All"><UiIcon Icon="settings" /><span>حساب من</span></NavLink></Authorized>
            <NotAuthorized><a href="@ClientRoutes.Accounts.Login"><UiIcon Icon="log-in" /><span>ورود</span></a></NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
<PalettePicker />
<NotificationPanel @bind-Open="_notificationsOpen" />
