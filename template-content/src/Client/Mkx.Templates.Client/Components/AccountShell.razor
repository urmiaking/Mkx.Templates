<section class="account-page" dir="rtl">
    @if (ShowBreadcrumb)
    {
        <nav class="account-breadcrumb" aria-label="مسیر صفحه"><a href="@BackHref"><UiIcon Icon="back" />@BackLabel</a><span aria-hidden="true">/</span><span aria-current="page">@Title</span></nav>
    }
    <header class="account-hero"><div><span class="account-overline">@Eyebrow</span><h1>@Title</h1>@if (!string.IsNullOrWhiteSpace(Description)) { <p>@Description</p> }</div>@if (Actions is not null) { <div class="account-hero-actions">@Actions</div> }</header>
    <div class="account-body">@ChildContent</div>
</section>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "مدیریت حساب";
    [Parameter] public bool ShowBreadcrumb { get; set; } = true;
    [Parameter] public string BackHref { get; set; } = ClientRoutes.Home.Index;
    [Parameter] public string BackLabel { get; set; } = "صفحه اصلی";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
