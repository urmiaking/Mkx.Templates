@inherits AppComponentBase
<NavigationLock ConfirmExternalNavigation="_dirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
<UiDialog>
    <DialogContent>
        <div data-unsaved="@(_dirty ? "true" : "false")"><UiForm @ref="_form">
            <UiTextField Label="نام" Value="@_name" ValueChanged="NameChanged" Required="true" MaxLength="200"
                          Error="@(ValidationErrors.ContainsKey("Name"))" ErrorText="@FieldError("Name")" Disabled="IsBusy" />
            <UiTextField Label="توضیحات" Value="@_description" ValueChanged="DescriptionChanged" MaxLength="500" Lines="3"
                          Error="@(ValidationErrors.ContainsKey("Description"))" ErrorText="@FieldError("Description")" Disabled="IsBusy" />
            @if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError</div> }
        </UiForm></div>
    </DialogContent>
    <DialogActions>
        <UiButton OnClick="CancelAsync" Disabled="IsBusy">انصراف</UiButton>
        <UiButton OnClick="SaveAsync" Disabled="IsBusy" Color="Color.Primary" Variant="Variant.Filled">@(IsBusy ? "در حال ذخیره…" : "ذخیره")</UiButton>
    </DialogActions>
</UiDialog>
