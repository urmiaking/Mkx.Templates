@implements IAsyncDisposable
@inject IJSRuntime JS
<dialog class="ui-modal @Class" @ref="_dialog" aria-labelledby="@_titleId" @onkeydown="KeyDown" @onclick="BackdropClick">
    <section class="ui-modal-panel" @ref="_panel" @onclick:stopPropagation="true">
        <header class="ui-modal-header"><h2 id="@_titleId">@Title</h2>@if (ShowClose) { <UiIconButton Icon="close" aria-label="بستن" Disabled="Busy" OnClick="Close" /> }</header>
        @ChildContent
    </section>
</dialog>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _titleId = "modal-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog, _panel;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal.js");
        await _module.InvokeVoidAsync("activate", _panel, _dialog);
    }
    private Task Close() => Busy ? Task.CompletedTask : OnClose.InvokeAsync();
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" && CloseOnEscape ? Close() : Task.CompletedTask;
    private Task BackdropClick() => CloseOnBackdrop ? Close() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) { await _module.InvokeVoidAsync("deactivate", _panel, _dialog); await _module.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
    }
}
