@using Mkx.Templates.Shared.DTOs.Users
@attribute [Route(ClientRoutes.Users.Index)]
@attribute [Authorize(Policy = AppPolicies.Users.View)]

@using Mkx.Templates.Sdk.Server.Shared.Authorization
@using Mkx.Templates.Sdk.Shared.Extensions
@using Mkx.Templates.Client.Extensions
@inherits AppComponentBase

<PageTitle>مدیریت کاربران و دسترسی‌ها</PageTitle>

@if (_isDisabled)
{
    <section class="ui-container pt-8 text-center">
        <section class="ui-panel pa-6 rounded-lg my-4">
            <UiIcon Icon="lock" Color="Color.Warning" Class="mb-3" />
            <h6 class="fw-bold mb-2">مدیریت کاربران غیرفعال است</h6>
            <p class="ui-type-body2 ui-color-secondary">
                بخش مدیریت کاربران در دسترس نمی‌باشد.
            </p>
        </section>
    </section>
}
else
{
    <AccountShell Title="کاربران و دسترسی‌ها" Description="حساب‌های کاربری، نقش‌ها و سطوح دسترسی را مدیریت کنید." Eyebrow="مدیریت سامانه">
<Actions><UiButton Variant="Variant.Outlined" StartIcon="key" Href="@ClientRoutes.Users.RoleClaims">دسترسی نقش‌ها</UiButton><AuthorizeView Policy="@AppPolicies.Users.Manage"><UiButton Variant="Variant.Filled" StartIcon="plus" OnClick="OpenAddUserDialog">افزودن کاربر</UiButton></AuthorizeView></Actions>
<ChildContent>
        <section class="ui-panel pa-4 rounded-lg ">
            <div class="d-flex align-center justify-space-between mb-4 gap-4 flex-wrap">
                <UiTextField Label="جستجوی کاربران" Value="@_searchQuery" ValueChanged="SearchChanged" DebounceInterval="350"
                              Placeholder="جستجو بر اساس نام، نام کاربری یا ایمیل..."
                              Class="flex-grow-1"
                              Style="max-width: 400px;" />
            </div>

            @if (_loadFailed) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError <UiButton OnClick="LoadUsersAsync" Disabled="IsBusy">تلاش دوباره</UiButton></div> }
            <UiTable T="UserDto" @ref="_table" ServerData="LoadPageAsync" RowsPerPage="25">
                <HeaderContent>
                    <th>کاربر</th>
                    <th>اطلاعات تماس</th>
                    <th>نقش‌های سیستم</th>
                    <th>دسترسی‌های مستقیم</th>
                    <th style="text-align: left;">عملیات</th>
                </HeaderContent>
                <RowTemplate Context="user">
                    <td data-label="کاربر">
                        <div class="d-flex align-center gap-3">
                            <span class="ui-avatar ui-color-secondary">
                                @(Mkx.Templates.Sdk.Shared.Extensions.StringExtensions.GetInitialsWithPeriods(user.Name))
                            </span>
                            <div>
                                <p class="fw-bold ui-type-subtitle2">@user.Name</p>
                                <p class="ui-type-caption ui-color-secondary">@@@user.UserName</p>
                            </div>
                        </div>
                    </td>

                    <td data-label="اطلاعات تماس">
                        <div>
                            @if (!string.IsNullOrEmpty(user.Email))
                            {
                                <div class="d-flex align-center gap-1">
                                    <UiIcon Icon="mail" Color="Color.Secondary" />
                                    <p class="ui-type-body2">@user.Email</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(user.PhoneNumber))
                            {
                                <div class="d-flex align-center gap-1">
                                    <UiIcon Icon="phone" Color="Color.Secondary" />
                                    <p class="ui-type-caption">@user.PhoneNumber</p>
                                </div>
                            }
                            @if (string.IsNullOrEmpty(user.Email) && string.IsNullOrEmpty(user.PhoneNumber))
                            {
                                <p class="ui-type-caption ui-color-secondary">ثبت نشده</p>
                            }
                        </div>
                    </td>

                    <td data-label="نقش‌های سیستم">
                        <div class="d-flex flex-wrap gap-1">
                            @if (!user.Roles.Any())
                            {
                                <span class="ui-chip ui-color-secondary">بدون نقش</span>
                            }
                            else
                            {
                                @foreach (var role in user.Roles)
                                {
                                    <span class="ui-chip ui-color-default">@role.GetRoleName()</span>
                                }
                            }
                        </div>
                    </td>

                    <td data-label="دسترسی‌های مستقیم">
                        <span class="ui-chip ui-color-success">
                            @user.DirectClaimsCount دسترسی اختصاصی
                        </span>
                    </td>

                    <td data-label="عملیات" style="text-align: left;">
                        <div class="d-flex align-center justify-end gap-1">
                            <AuthorizeView Policy="@AppPolicies.Users.ManageClaims" Context="authCtx1">
                                <span title="تنظیم دسترسی‌های کاربر">
                                    <UiIconButton aria-label="تنظیم دسترسی" Icon="key"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => ManageUserClaims(user))" />
                                </span>
                            </AuthorizeView>

                            <AuthorizeView Policy="@AppPolicies.Users.Manage" Context="authCtx2">
                                <span title="ویرایش کاربر">
                                    <UiIconButton aria-label="ویرایش" Icon="edit"
                                                   Color="Color.Info"
                                                   OnClick="@(() => OpenEditUserDialog(user))" />
                                </span>

                                @if (!user.Roles.Contains(BuiltinRoles.Administrators))
                                {
                                    <span title="حذف کاربر">
                                        <UiIconButton aria-label="حذف" Icon="trash"
                                                       Color="Color.Error"
                                                       OnClick="@(() => ConfirmDeleteUser(user))" />
                                    </span>
                                }
                            </AuthorizeView>
                        </div>
                    </td>
                </RowTemplate>
                <NoRecordsContent>
                    <p class="pa-4 text-center ui-color-secondary">@(_loadFailed ? "دریافت اطلاعات انجام نشد." : "هیچ کاربری یافت نشد.")</p>
                </NoRecordsContent>

            </UiTable>
        </section>

</ChildContent></AccountShell>
}
