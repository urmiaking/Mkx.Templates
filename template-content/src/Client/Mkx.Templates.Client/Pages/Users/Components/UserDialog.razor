@using Mkx.Templates.Shared.DTOs.Users
@using Mkx.Templates.Sdk.Server.Shared.Authorization
@using Mkx.Templates.Client.Extensions
@inherits AppComponentBase

<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
<div data-unsaved="@(IsDirty ? "true" : "false")"><UiForm Model="Model" @ref="@_form">
    <UiDialog>
        <DialogContent>
            @if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError</div> }
            <div class="d-flex flex-column gap-3 py-2">
                <UiTextField @bind-Value="Model.Name"
                              Label="نام و نام خانوادگی"
                              Required="true"
                              RequiredError="نام و نام خانوادگی الزامی است" />

                <UiTextField @bind-Value="Model.UserName"
                              Label="نام کاربری"
                              Disabled="@IsEdit"
                              Required="true"
                              RequiredError="نام کاربری الزامی است" />

                <UiTextField @bind-Value="Model.Email"
                              Label="ایمیل"
                              InputType="InputType.Email" />

                <UiTextField @bind-Value="Model.PhoneNumber"
                              Label="شماره همراه"
                              InputType="InputType.Telephone" />

                <UiTextField @bind-Value="Model.Password"
                              Label="@(IsEdit ? "کلمه عبور جدید (در صورت عدم تغییر خالی بگذارید)" : "کلمه عبور")"
                              InputType="InputType.Password"
                              Required="@(!IsEdit)"
                              RequiredError="کلمه عبور الزامی است" />

                <div>
                    <p class="mb-1 ui-type-body2">نقش‌های سیستم:</p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var role in BuiltinRoles.Roles)
                        {
                            <UiCheckBox T="bool"
                                         Value="@Model.SelectedRoles.Contains(role)"
                                         ValueChanged="@(val => ToggleRole(role, val))"
                                         Color="Color.Primary">
                                @role.GetRoleName()
                            </UiCheckBox>
                        }
                    </div>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <UiButton OnClick="CancelAsync" Disabled="IsBusy" Variant="Variant.Text">انصراف</UiButton>
            <UiButton OnClick="Submit" Disabled="IsBusy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="check">
                ذخیره
            </UiButton>
        </DialogActions>
    </UiDialog>
</UiForm></div>
