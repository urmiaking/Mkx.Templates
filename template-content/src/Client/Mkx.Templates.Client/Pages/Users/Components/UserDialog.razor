@using Mkx.Templates.Shared.DTOs.Users
@using Mkx.Templates.Sdk.Server.Shared.Authorization
@using Mkx.Templates.Client.Extensions
@inherits AppComponentBase

<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
<div data-unsaved="@(IsDirty ? "true" : "false")"><MudForm Model="Model" @ref="@_form">
    <MudDialog>
        <DialogContent>
            @if (LastRequestError is not null) { <MudAlert Severity="Severity.Error" role="alert">@LastRequestError</MudAlert> }
            <div class="d-flex flex-column gap-3 py-2">
                <MudTextField @bind-Value="Model.Name"
                              Label="نام و نام خانوادگی"
                              Required="true"
                              RequiredError="نام و نام خانوادگی الزامی است"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField @bind-Value="Model.UserName"
                              Label="نام کاربری"
                              Disabled="@IsEdit"
                              Required="true"
                              RequiredError="نام کاربری الزامی است"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField @bind-Value="Model.Email"
                              Label="ایمیل"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField @bind-Value="Model.PhoneNumber"
                              Label="شماره همراه"
                              InputType="InputType.Telephone"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <MudTextField @bind-Value="Model.Password"
                              Label="@(IsEdit ? "کلمه عبور جدید (در صورت عدم تغییر خالی بگذارید)" : "کلمه عبور")"
                              InputType="InputType.Password"
                              Required="@(!IsEdit)"
                              RequiredError="کلمه عبور الزامی است"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

                <div>
                    <MudText Typo="Typo.body2" Class="mb-1">نقش‌های سیستم:</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var role in BuiltinRoles.Roles)
                        {
                            <MudCheckBox T="bool"
                                         Value="@Model.SelectedRoles.Contains(role)"
                                         ValueChanged="@(val => ToggleRole(role, val))"
                                         Color="Color.Primary"
                                         Dense="true">
                                @role.GetRoleName()
                            </MudCheckBox>
                        }
                    </div>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CancelAsync" Disabled="IsBusy" Variant="Variant.Text">انصراف</MudButton>
            <MudButton OnClick="Submit" Disabled="IsBusy" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save">
                ذخیره
            </MudButton>
        </DialogActions>
    </MudDialog>
</MudForm></div>
