@using Mkx.Templates.Shared.DTOs.Claims
@inherits AppComponentBase

<UiDialog>
    <DialogContent>
        <div style="max-height: 60vh; overflow-y: auto;" class="d-flex flex-column gap-3 py-2 px-1">
            <div class="ui-alert mb-1 ui-alert-info">
                برای تغییر دسترسی‌ها، گزینه‌های مورد نظر را علامت بزنید. با علامت زدن هر بخش، تمامی زیرمجموعه‌های آن به طور خودکار تغییر می‌یابند.
            </div>

            <div class="d-flex align-center justify-space-between gap-2">
                <UiTextField @bind-Value="_searchQuery"
                              Placeholder="جستجو در دسترسی‌ها..."
                              Class="flex-grow-1" />

                <UiButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@SelectAll">
                    انتخاب همه
                </UiButton>
                <UiButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@DeselectAll">
                    لغو همه
                </UiButton>
            </div>

            <hr class="ui-divider my-1" />

            <div class="d-flex flex-column gap-3 pb-8">
                @foreach (var category in FilteredTree)
                {
                    <section class="ui-panel pa-3 border-solid border border-primary-lighten-4" style="border-radius: 8px; background-color: var(--ui-background-grey);">
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <UiIcon Icon="folder" Color="Color.Primary" />
                                <p class="fw-bold color-primary ui-type-subtitle1">@category.Description</p>
                            </div>
                            <UiCheckBox T="bool"
                                         Value="@category.IsGranted"
                                         ValueChanged="@(val => ToggleNode(category, val))"
                                         Color="Color.Primary">
                                <span class="text-caption font-weight-medium">انتخاب این گروه</span>
                            </UiCheckBox>
                        </div>

                        @if (category.Children.Any())
                        {
                            <div class="d-flex flex-column gap-1 pl-4 mt-2">
                                @foreach (var child in category.Children)
                                {
                                    @RenderPolicyNode(child, 1, MatchesSelf(category, _searchQuery))
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <UiButton OnClick="Cancel" Variant="Variant.Text">انصراف</UiButton>
        <UiButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" StartIcon="check">
            ذخیره دسترسی‌ها
        </UiButton>
    </DialogActions>
</UiDialog>

@code {
    [CascadingParameter] private DialogSession Dialog { get; set; } = default!;
    [Parameter] public List<PolicyTreeNodeDto> InitialTree { get; set; } = [];

    private List<PolicyTreeNodeDto> _tree = [];
    private string _searchQuery = string.Empty;

    protected override void OnInitialized()
    {
        _tree = InitialTree;
    }

    private IEnumerable<PolicyTreeNodeDto> FilteredTree =>
        _tree.Where(node => MatchesNode(node, _searchQuery));

    private static bool MatchesSelf(PolicyTreeNodeDto node, string query) =>
        string.IsNullOrWhiteSpace(query) ||
        node.Description.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) ||
        node.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool MatchesNode(PolicyTreeNodeDto node, string query) =>
        MatchesSelf(node, query) || node.Children.Any(child => MatchesNode(child, query));

    private RenderFragment RenderPolicyNode(PolicyTreeNodeDto node, int level, bool showAll = false) => __builder =>
    {
        if (!showAll && !MatchesNode(node, _searchQuery))
            return;

        var indentStyle = level switch
        {
            1 => "margin-right: 8px;",
            2 => "margin-right: 24px; border-right: 2px solid var(--ui-primary); padding-right: 12px;",
            _ => "margin-right: 36px; border-right: 2px solid var(--ui-secondary); padding-right: 12px;"
        };

        <div class="my-1" style="@indentStyle">
            <div class="d-flex align-center justify-space-between py-1 px-2 rounded hover-light">
                <div class="d-flex align-center gap-2">
                    <UiIcon Icon="@(node.Children.Any() ? "list" : "key")" Color="Color.Default" />
                    <div>
                        <p class="fw-medium ui-type-body2">@node.Description</p>
                        <p class="ui-type-caption ui-color-secondary" style="font-size: 0.75rem;">@node.Name</p>
                    </div>
                </div>

                <UiCheckBox T="bool"
                             Value="@node.IsGranted"
                             ValueChanged="@(val => ToggleNode(node, val))"
                             Color="Color.Success" />
            </div>

            @if (node.Children.Any())
            {
                <div class="d-flex flex-column gap-1">
                    @foreach (var childNode in node.Children)
                    {
                        @RenderPolicyNode(childNode, level + 1, showAll || MatchesSelf(node, _searchQuery))
                    }
                </div>
            }
        </div>
    };

    private void ToggleNode(PolicyTreeNodeDto node, bool value)
    {
        node.IsGranted = value;
        SetChildrenState(node.Children, value);
        StateHasChanged();
    }

    private void SetChildrenState(List<PolicyTreeNodeDto> children, bool value)
    {
        foreach (var child in children)
        {
            child.IsGranted = value;
            if (child.Children.Any())
            {
                SetChildrenState(child.Children, value);
            }
        }
    }

    private void SelectAll()
    {
        SetChildrenState(_tree, true);
        foreach (var cat in _tree)
        {
            cat.IsGranted = true;
        }
        StateHasChanged();
    }

    private void DeselectAll()
    {
        SetChildrenState(_tree, false);
        foreach (var cat in _tree)
        {
            cat.IsGranted = false;
        }
        StateHasChanged();
    }

    private void Submit()
    {
        var grantedClaimNames = new List<string>();
        CollectGrantedClaims(_tree, grantedClaimNames);
        Dialog.Close(DialogResult.Ok(grantedClaimNames));
    }

    private void CollectGrantedClaims(List<PolicyTreeNodeDto> nodes, List<string> list)
    {
        foreach (var node in nodes)
        {
            if (node.IsGranted && !node.Name.StartsWith("Category_"))
            {
                list.Add(node.Name);
            }
            if (node.Children.Any())
            {
                CollectGrantedClaims(node.Children, list);
            }
        }
    }

    private void Cancel() => Dialog.Cancel();
}
