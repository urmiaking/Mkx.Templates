@using Mkx.Templates.Shared.DTOs.Claims
@using Mkx.Templates.Shared.Abstractions
@inherits AppComponentBase

<UiDialog>
    <DialogContent>
        <div class="claims-editor">
            <p class="claims-hint">انتخاب هر بخش، دسترسی‌های زیرمجموعهٔ آن را هم تغییر می‌دهد.</p>
            <div class="claims-toolbar">
                <UiTextField @bind-Value="_searchQuery" Label="جستجوی دسترسی‌ها" Placeholder="نام دسترسی…" Class="claims-search" DebounceInterval="150" Disabled="IsBusy" />
                <div class="claims-bulk"><UiButton Variant="Variant.Outlined" OnClick="SelectAll" Disabled="IsBusy">انتخاب همه</UiButton><UiButton Variant="Variant.Outlined" OnClick="DeselectAll" Disabled="IsBusy">لغو همه</UiButton></div>
            </div>
            <div class="claims-summary"><span role="status">@CountGranted(_tree) از @CountPermissions(_tree) دسترسی انتخاب شده</span><span>انتخاب‌ها با ذخیره اعمال می‌شوند</span></div>
            @if (!string.IsNullOrEmpty(LastRequestError)) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError</div> }
            @if (!FilteredTree.Any())
            {
                <p class="ui-empty">دسترسی‌ای با این عبارت پیدا نشد.</p>
            }
            else
            {
                <div class="claims-groups">
                    @foreach (var category in FilteredTree)
                    {
                        <fieldset class="claims-group" @key="category.Name" disabled="@IsBusy">
                            <legend><UiCheckBox T="bool" Value="@(category.Children.Count > 0 ? category.Children.All(IsFullyGranted) : category.IsGranted)" ValueChanged="@(value => ToggleNode(category, value))" Disabled="IsBusy"><span>@category.Description</span></UiCheckBox></legend>
                            @if (category.Children.Count > 0)
                            {
                                <ul class="claims-tree">
                                    @foreach (var child in category.Children) { @RenderPolicyNode(child, MatchesSelf(category, _searchQuery)) }
                                </ul>
                            }
                        </fieldset>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <UiButton OnClick="Cancel" Variant="Variant.Text" Disabled="IsBusy">انصراف</UiButton>
        <UiButton OnClick="SubmitAsync" Variant="Variant.Filled" StartIcon="check" Disabled="IsBusy">@(IsBusy ? "در حال ذخیره…" : "ذخیره دسترسی‌ها")</UiButton>
    </DialogActions>
</UiDialog>

@code {
    [CascadingParameter] private DialogSession Dialog { get; set; } = default!;
    [Parameter] public List<PolicyTreeNodeDto> InitialTree { get; set; } = [];
    [Parameter] public Func<IUserManagementService, List<string>, CancellationToken, Task>? SaveChanges { get; set; }
    private List<PolicyTreeNodeDto> _tree = [];
    private string _searchQuery = string.Empty;
    protected override void OnInitialized() => _tree = InitialTree;
    private IEnumerable<PolicyTreeNodeDto> FilteredTree => _tree.Where(node => MatchesNode(node, _searchQuery));
    private static bool MatchesSelf(PolicyTreeNodeDto node, string query) => string.IsNullOrWhiteSpace(query)
        || node.Description.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) || node.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);
    private static bool MatchesNode(PolicyTreeNodeDto node, string query) => MatchesSelf(node, query) || node.Children.Any(child => MatchesNode(child, query));
    private static bool IsFullyGranted(PolicyTreeNodeDto node) => node.IsGranted && node.Children.All(IsFullyGranted);
    private static int CountPermissions(IEnumerable<PolicyTreeNodeDto> nodes) => nodes.Sum(node => (node.Name.StartsWith("Category_", StringComparison.Ordinal) ? 0 : 1) + CountPermissions(node.Children));
    private static int CountGranted(IEnumerable<PolicyTreeNodeDto> nodes) => nodes.Sum(node => (node.IsGranted && !node.Name.StartsWith("Category_", StringComparison.Ordinal) ? 1 : 0) + CountGranted(node.Children));

    private RenderFragment RenderPolicyNode(PolicyTreeNodeDto node, bool showAll = false) => __builder =>
    {
        if (!showAll && !MatchesNode(node, _searchQuery)) return;
        <li class="claim-node" @key="node.Name">
            <label class="claim-choice" title="@node.Name"><input type="checkbox" checked="@node.IsGranted" disabled="@IsBusy" @onchange="@(args => ToggleNode(node, args.Value is true))" /><span>@node.Description</span></label>
            @if (node.Children.Count > 0)
            {
                <ul class="claims-children">
                    @foreach (var child in node.Children) { @RenderPolicyNode(child, showAll || MatchesSelf(node, _searchQuery)) }
                </ul>
            }
        </li>
    };
    private void ToggleNode(PolicyTreeNodeDto node, bool value) { node.IsGranted = value; SetChildrenState(node.Children, value); }
    private static void SetChildrenState(IEnumerable<PolicyTreeNodeDto> nodes, bool value)
    {
        foreach (var node in nodes) { node.IsGranted = value; SetChildrenState(node.Children, value); }
    }
    private void SelectAll() => SetChildrenState(_tree, true);
    private void DeselectAll() => SetChildrenState(_tree, false);
    private async Task SubmitAsync()
    {
        if (IsBusy) return;
        var names = new List<string>();
        CollectGrantedClaims(_tree, names);
        if (SaveChanges is not null)
        {
            var saved = await TryRequestAsync<IUserManagementService, bool>(async (service, token) => { await SaveChanges(service, names, token); return true; });
            if (!saved.Succeeded) return;
        }
        Dialog.Close(DialogResult.Ok(names));
    }
    private static void CollectGrantedClaims(IEnumerable<PolicyTreeNodeDto> nodes, List<string> names)
    {
        foreach (var node in nodes)
        {
            if (node.IsGranted && !node.Name.StartsWith("Category_", StringComparison.Ordinal)) names.Add(node.Name);
            CollectGrantedClaims(node.Children, names);
        }
    }
    private void Cancel() { if (!IsBusy) Dialog.Cancel(); }
}
