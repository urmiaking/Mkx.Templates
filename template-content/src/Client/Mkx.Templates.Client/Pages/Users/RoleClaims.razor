@attribute [Route(ClientRoutes.Users.RoleClaims)]
@attribute [Authorize(Policy = AppPolicies.Users.View)]

@using Mkx.Templates.Sdk.Server.Shared.Authorization
@inherits AppComponentBase

<PageTitle>مدیریت دسترسی نقش‌های سیستم</PageTitle>

@if (_isDisabled)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="pt-8 text-center">
        <MudPaper Class="pa-6 rounded-lg my-4" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
            <MudText Typo="Typo.h6" Class="fw-bold mb-2">مدیریت کاربران و نقش‌ها غیرفعال است</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                این بخش در دسترس نمی‌باشد.
            </MudText>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-6">
        <MudBreadcrumbs Class="px-0" Items="_breadcrumbs" MaxItems="3">
            <SeparatorTemplate>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
            </SeparatorTemplate>
        </MudBreadcrumbs>

        <MudPaper Class="pa-4 mb-4 rounded-lg glassy-card" Elevation="1">
            <div class="d-flex align-center justify-space-between gap-4 flex-wrap">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Medium" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5">مدیریت دسترسی نقش‌های ثابت سیستم</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">تعیین مجوز و دسترسی‌ها برای نقش‌های اصلی سیستم</MudText>
                    </div>
                </div>
            </div>
        </MudPaper>

        <MudPaper Class="pa-4 rounded-lg glassy-card" Elevation="1">
            <MudTable Items="_roles" Loading="@IsBusy" Hover="true" Elevation="0" Dense="false">
                <HeaderContent>
                    <MudTh>عنوان نقش</MudTh>
                    <MudTh>تعداد اعضا</MudTh>
                    <MudTh>تعداد دسترسی‌های فعال</MudTh>
                    <MudTh Style="text-align: left;">عملیات</MudTh>
                </HeaderContent>
                <RowTemplate Context="roleItem">
                    <MudTd DataLabel="عنوان نقش">
                        <div class="d-flex align-center gap-3">
                            <MudAvatar Color="@(roleItem.RoleName == BuiltinRoles.Administrators ? Color.Primary : Color.Info)" Size="Size.Medium">
                                <MudIcon Icon="@(roleItem.RoleName == BuiltinRoles.Administrators ? Icons.Material.Filled.Security : Icons.Material.Filled.Person)" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">
                                    @roleItem.RoleName.GetRoleName()
                                </MudText>
                            </div>
                        </div>
                    </MudTd>

                    <MudTd DataLabel="تعداد اعضا">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @roleItem.MemberCount کاربر
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="تعداد دسترسی‌های فعال">
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                            @roleItem.ClaimsCount مجوز تعریف شده
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="عملیات" Style="text-align: left;">
                        <AuthorizeView Policy="@AppPolicies.Users.ManageClaims" Context="authCtx">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.VpnKey"
                                       OnClick="@(() => ManageRoleClaims(roleItem.RoleName))">
                                تنظیم دسترسی‌های نقش
                            </MudButton>
                        </AuthorizeView>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudContainer>
}
