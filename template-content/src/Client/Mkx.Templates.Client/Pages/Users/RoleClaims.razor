@attribute [Route(ClientRoutes.Users.RoleClaims)]
@attribute [Authorize(Policy = AppPolicies.Users.View)]

@using Mkx.Templates.Sdk.Server.Shared.Authorization
@inherits AppComponentBase

<PageTitle>مدیریت دسترسی نقش‌های سیستم</PageTitle>

@if (_isDisabled)
{
    <section class="ui-container pt-8 text-center">
        <section class="ui-panel pa-6 rounded-lg my-4">
            <UiIcon Icon="lock" Color="Color.Warning" Class="mb-3" />
            <h6 class="fw-bold mb-2">مدیریت کاربران و نقش‌ها غیرفعال است</h6>
            <p class="ui-type-body2 ui-color-secondary">
                این بخش در دسترس نمی‌باشد.
            </p>
        </section>
    </section>
}
else
{
    <AccountShell Title="دسترسی نقش‌ها" Description="مجوزهای نقش‌های اصلی سامانه را تنظیم کنید." Eyebrow="مدیریت سامانه">

<ChildContent>
        <section class="ui-panel pa-4 rounded-lg ">
            <UiTable Items="_roles">
                <HeaderContent>
                    <th>عنوان نقش</th>
                    <th>تعداد اعضا</th>
                    <th>تعداد دسترسی‌های فعال</th>
                    <th style="text-align: left;">عملیات</th>
                </HeaderContent>
                <RowTemplate Context="roleItem">
                    <td data-label="عنوان نقش">
                        <div class="d-flex align-center gap-3">
                            <span class="ui-avatar ui-color-info">
                                <UiIcon Icon="@(roleItem.RoleName == BuiltinRoles.Administrators ? "security" : "user")" />
                            </span>
                            <div>
                                <p class="fw-bold ui-type-subtitle1">
                                    @roleItem.RoleName.GetRoleName()
                                </p>
                            </div>
                        </div>
                    </td>

                    <td data-label="تعداد اعضا">
                        <span class="ui-chip ui-color-default">
                            @roleItem.MemberCount کاربر
                        </span>
                    </td>

                    <td data-label="تعداد دسترسی‌های فعال">
                        <span class="ui-chip ui-color-success">
                            @roleItem.ClaimsCount مجوز تعریف شده
                        </span>
                    </td>

                    <td data-label="عملیات" style="text-align: left;">
                        <AuthorizeView Policy="@AppPolicies.Users.ManageClaims" Context="authCtx">
                            <UiButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="key"
                                       OnClick="@(() => ManageRoleClaims(roleItem.RoleName))">
                                تنظیم دسترسی‌های نقش
                            </UiButton>
                        </AuthorizeView>
                    </td>
                </RowTemplate>
            </UiTable>
        </section>

</ChildContent></AccountShell>
}
