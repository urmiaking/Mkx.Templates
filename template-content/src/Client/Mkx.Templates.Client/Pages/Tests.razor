@attribute [Route(ClientRoutes.Tests.Index)]
@attribute [Authorize(Policy = AppPolicies.Tests.View)]
@inherits AppComponentBase
<PageTitle>تست‌ها</PageTitle>
<AccountShell Title="تست‌ها" Description="رکوردهای نمونه را جستجو، ایجاد و ویرایش کنید." Eyebrow="فضای کار">
    <div class="ui-stack mb-4 tests-toolbar ui-row">
        <UiTextField Class="tests-search" Label="جستجوی نام یا توضیحات" Value="@_search" ValueChanged="SearchChanged" DebounceInterval="350" />
        <AuthorizeView Policy="@AppPolicies.Tests.Manage"><UiButton Class="tests-add" OnClick="@(() => EditAsync(null))" Color="Color.Primary" Variant="Variant.Filled" Disabled="IsBusy">افزودن</UiButton></AuthorizeView>
    </div>
    @if (_loadFailed) {
        <div class="ui-alert mb-3 ui-alert-error" role="alert">@LastRequestError <UiButton OnClick="ReloadAsync" Disabled="IsBusy">تلاش دوباره</UiButton></div>
    }
    <UiTable T="GetTestResponse" @ref="_table" ServerData="LoadAsync" RowsPerPage="25">
        <HeaderContent>
            <th><UiTableSortLabel SortLabel="Name" T="GetTestResponse">نام</UiTableSortLabel></th><th>توضیحات</th><th>عملیات</th>
        </HeaderContent>
        <RowTemplate>
            <td data-label="نام">@context.Name</td><td data-label="توضیحات">@context.Description</td>
            <td data-label="عملیات"><AuthorizeView Policy="@AppPolicies.Tests.Manage" Context="authorization">
                <UiIconButton Icon="edit" aria-label="ویرایش تست" OnClick="@(() => EditAsync(context))" Disabled="IsBusy" />
                <UiIconButton Icon="trash" aria-label="حذف تست" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="IsBusy" />
            </AuthorizeView></td>
        </RowTemplate>
        <NoRecordsContent><p class="pa-4">@(_loadFailed ? "دریافت اطلاعات انجام نشد." : "موردی یافت نشد.")</p></NoRecordsContent>

    </UiTable>
</AccountShell>
