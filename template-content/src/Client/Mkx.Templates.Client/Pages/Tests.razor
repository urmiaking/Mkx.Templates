@attribute [Route(ClientRoutes.Tests.Index)]
@attribute [Authorize(Policy = AppPolicies.Tests.View)]
@inherits AppComponentBase
<PageTitle>تست‌ها</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" Class="mb-4">مدیریت تست‌ها</MudText>
    <MudStack Row="true" Class="mb-4 tests-toolbar" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField T="string" Class="tests-search" Margin="Margin.None" Label="جستجوی نام یا توضیحات" Value="_search" ValueChanged="SearchChanged" DebounceInterval="350" Clearable="true" Variant="Variant.Outlined" />
        <AuthorizeView Policy="@AppPolicies.Tests.Manage"><MudButton Class="tests-add" OnClick="@(() => EditAsync(null))" Color="Color.Primary" Variant="Variant.Filled" Disabled="IsBusy">افزودن</MudButton></AuthorizeView>
    </MudStack>
    @if (_loadFailed) {
        <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@LastRequestError <MudButton OnClick="ReloadAsync" Disabled="IsBusy">تلاش دوباره</MudButton></MudAlert>
    }
    <MudTable T="GetTestResponse" @ref="_table" ServerData="LoadAsync" Hover="true" RowsPerPage="25" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="Name" T="GetTestResponse">نام</MudTableSortLabel></MudTh><MudTh>توضیحات</MudTh><MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام">@context.Name</MudTd><MudTd DataLabel="توضیحات">@context.Description</MudTd>
            <MudTd DataLabel="عملیات"><AuthorizeView Policy="@AppPolicies.Tests.Manage" Context="authorization">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="ویرایش تست" OnClick="@(() => EditAsync(context))" Disabled="IsBusy" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="حذف تست" Color="Color.Error" OnClick="@(() => DeleteAsync(context))" Disabled="IsBusy" />
            </AuthorizeView></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">@(_loadFailed ? "دریافت اطلاعات انجام نشد." : "موردی یافت نشد.")</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50, 100 })" /></PagerContent>
    </MudTable>
</MudContainer>
