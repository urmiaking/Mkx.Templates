@attribute [Route(ClientRoutes.UserAccounts.ExternalLogins)]
@attribute [Authorize]
@inherits AppComponentBase
<PageTitle>حساب‌های متصل</PageTitle>
<AccountShell Title="حساب‌های متصل" Description="روش‌های ورود از طریق سرویس‌های دیگر را مدیریت کنید." BackHref="@ClientRoutes.UserAccounts.Index" BackLabel="حساب من">
    @if (_externalLogins is null)
    { @if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError <UiButton OnClick="LoadExternalProvidersAsync" Disabled="IsBusy">تلاش دوباره</UiButton></div> } else { <span class="ui-spinner" role="status" aria-label="دریافت سرویس‌ها"></span> } }
    else
    {
        <section class="account-panel"><header class="account-panel-head"><div><h2>سرویس‌های متصل</h2><p>حساب‌هایی که می‌توانید با آن‌ها وارد شوید</p></div><UiIcon Icon="link" /></header>
            @if (_externalLogins.CurrentLogins.Count == 0) { <div class="account-empty"><UiIcon Icon="link" /><h3>حسابی متصل نشده است</h3><p>از سرویس‌های در دسترس در بخش زیر استفاده کنید.</p></div> }
            @foreach (var login in _externalLogins.CurrentLogins)
            { <div class="account-detail-row"><div class="d-flex align-center gap-3"><span class="action-symbol"><UiIcon Icon="@GetProviderIcon(login.Provider)" /></span><strong>@(login.ProviderDisplayName ?? login.Provider)</strong></div><span class="ui-chip ui-color-success">متصل</span></div> }
        </section>
        <section class="account-panel"><header class="account-panel-head"><div><h2>اتصال سرویس جدید</h2><p>یک روش دیگر برای ورود به حساب اضافه کنید.</p></div></header>
            @if (_externalLogins.OtherProviders.Count == 0) { <p class="account-note">سرویس دیگری در دسترس نیست.</p> }
            @foreach (var provider in _externalLogins.OtherProviders)
            { <div class="account-detail-row"><div class="d-flex align-center gap-3"><span class="action-symbol"><UiIcon Icon="@GetProviderIcon(provider.Name)" /></span><strong>@(provider.DisplayName ?? provider.Name)</strong></div><UiButton Variant="Variant.Outlined" Disabled="@_buttonDisabled" OnClick="@(() => StartExternalLogin(provider.Name))">@(_buttonDisabled ? "در حال اتصال…" : "اتصال حساب")</UiButton></div> }
        </section>
    }
</AccountShell>
