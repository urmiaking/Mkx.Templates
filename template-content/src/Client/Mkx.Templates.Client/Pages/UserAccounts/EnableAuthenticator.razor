@attribute [Route(ClientRoutes.UserAccounts.EnableAuthenticator)]
@attribute [Authorize]
@inherits AppComponentBase
<PageTitle>اتصال برنامه رمزساز</PageTitle>
<AccountShell Title="اتصال برنامه رمزساز" Description="با سه گام ساده، ورود دو مرحله‌ای حساب خود را فعال کنید." BackHref="@ClientRoutes.UserAccounts.TwoFactorAuthentication" BackLabel="امنیت حساب">
    @if (LastRequestError is not null)
    { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError <UiButton Disabled="IsBusy" OnClick="LoadSharedKeyAndQrCodeUriAsync">تلاش دوباره</UiButton></div> }
    <div class="authenticator-steps">
        <section class="authenticator-step"><span class="authenticator-step-index">۱</span><div class="authenticator-step-main"><h2>یک برنامه رمزساز نصب کنید</h2><p>از Google Authenticator یا Microsoft Authenticator روی تلفن همراه خود استفاده کنید.</p>
            <div class="authenticator-apps"><UiButton Variant="Variant.Outlined" Href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" Target="_blank" StartIcon="external">Google · Android</UiButton><UiButton Variant="Variant.Outlined" Href="https://apps.apple.com/app/google-authenticator/id388497605" Target="_blank" StartIcon="external">Google · iOS</UiButton><UiButton Variant="Variant.Outlined" Href="https://www.microsoft.com/security/mobile-authenticator-app" Target="_blank" StartIcon="external">Microsoft Authenticator</UiButton></div>
        </div></section>
        <section class="authenticator-step"><span class="authenticator-step-index">۲</span><div class="authenticator-step-main"><h2>حساب را به برنامه اضافه کنید</h2><p>این کد QR را اسکن کنید یا کلید زیر را به‌صورت دستی در برنامه وارد کنید.</p>
            @if (_authenticatorKey is not null)
            {
                <svg xmlns="http://www.w3.org/2000/svg" class="authenticator-qr" viewBox="@($"-4 -4 {_qrSize + 8} {_qrSize + 8}")" role="img" aria-label="کد اتصال برنامه رمزساز"><path d="@_svgGraphicsPath" fill="#000" /></svg>
                <code class="authenticator-secret">@_formattedKey</code>
            }
            else if (IsBusy) { <span class="ui-spinner" role="status" aria-label="دریافت کلید اتصال"></span> }
        </div></section>
        <section class="authenticator-step"><span class="authenticator-step-index">۳</span><div class="authenticator-step-main"><h2>کد برنامه را تأیید کنید</h2><p>کد شش‌رقمی فعلی برنامه را وارد کنید. پس از تکمیل کد، تأیید آغاز می‌شود.</p><div class="authenticator-verify mt-4">
            <UiOtpField @bind-Value="_code" Sms="false" Disabled="@(IsBusy || _authenticatorKey is null)" OnCompleted="OnEnable" Label="کد برنامه رمزساز" />
            <UiButton Variant="Variant.Filled" Disabled="@(IsBusy || _authenticatorKey is null || _code?.Length != 6)" OnClick="OnEnable">@if (IsBusy) { <span class="ui-spinner" aria-hidden="true"></span> } فعال‌سازی ورود دو مرحله‌ای</UiButton>
        </div></div></section>
    </div>
</AccountShell>
