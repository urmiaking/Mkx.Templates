@attribute [Route(ClientRoutes.UserAccounts.AccountsList)]
@attribute [Authorize(Roles = BuiltinRoles.Administrators)]
@using Mkx.Templates.Shared.DTOs.UserAccounts
@inherits AppComponentBase

<PageTitle>مدیریت کاربران</PageTitle>

<AccountShell Title="حساب‌های کاربری" Description="وضعیت و اطلاعات حساب‌های سامانه را مدیریت کنید." Eyebrow="مدیریت سامانه">
    <UiTable @ref="_table" T="GetUserAccountResponse" ServerData="LoadUsersAsync" Class="" RowsPerPage="RowsPerPage">
        <ToolBarContent>
            <UiTextField Label="جستجوی حساب‌ها" Value="@_searchString" ValueChanged="OnSearch" DebounceInterval="500"
                          Placeholder="جستجو بر اساس نام، نام کاربری و شماره تلفن ..."></UiTextField>
            <div class="ui-responsive ui-mobile-only">
                <UiIconButton aria-label="افزودن" Variant="Variant.Filled"
                               OnClick="OnAddAccount" Class="me-2"
                               Color="Color.Primary" Icon="plus" />
            </div>
            <div class="ui-responsive ui-desktop-only">
                <span class="ui-spacer"></span>
                <UiButton Variant="Variant.Filled"
                           OnClick="OnAddAccount" Class="me-2"
                           Color="Color.Primary" StartIcon="plus">کاربر جدید</UiButton>
            </div>
        </ToolBarContent>
        <HeaderContent>
            <th>نام کاربری</th>
            <th>نام و نام خانوادگی</th>
            <th>شماره تماس</th>
            <th>نقش</th>
            <th>عملیات</th>
        </HeaderContent>
        <RowTemplate>
            <td data-label="نام کاربری">@context.Username</td>
            <td data-label="نام و نام خانوادگی">@context.FullName</td>
            <td data-label="شماره تماس">@(string.IsNullOrEmpty(context.PhoneNumber) ? "-" : context.PhoneNumber)</td>
            <td data-label="نقش">@context.Role.GetRoleName()</td>
            <td data-label="عملیات">
                <div class="d-flex gap-2">
                    <div class="ui-responsive ui-desktop-only">
                        <UiButton Variant="Variant.Outlined"
                                   OnClick="_ => OnEditAccount(context)"
                                   Color="Color.Info" StartIcon="edit">ویرایش</UiButton>
                    </div>
                    <div class="ui-responsive ui-mobile-only">
                        <UiIconButton aria-label="تغییر نمایش" Variant="Variant.Filled"
                                       OnClick="_ => OnEditAccount(context)"
                                       Color="Color.Info" Icon="edit" />
                    </div>

                    @if (context.IsActive)
                    {
                        <div class="ui-responsive ui-desktop-only">
                            <UiButton StartIcon="lock"
                                       Color="Color.Warning" Variant="Variant.Outlined"
                                       OnClick="@(() => LockUser(context))">غیرفعال سازی</UiButton>
                        </div>
                        <div class="ui-responsive ui-mobile-only">
                            <UiIconButton aria-label="قفل کردن" Icon="lock"
                                           Color="Color.Warning" Variant="Variant.Filled"
                                           OnClick="@(() => LockUser(context))" />
                        </div>

                    }
                    else
                    {
                        <div class="ui-responsive ui-desktop-only">
                            <UiButton StartIcon="unlock"
                                       Color="Color.Success" Variant="Variant.Outlined"
                                       OnClick="@(() => UnlockUser(context))">فعالسازی</UiButton>
                        </div>
                        <div class="ui-responsive ui-mobile-only">
                            <UiIconButton aria-label="باز کردن قفل" Icon="unlock"
                                           Color="Color.Success" Variant="Variant.Filled"
                                           OnClick="@(() => UnlockUser(context))" />
                        </div>
                    }
                    <div class="ui-responsive ui-desktop-only">
                        <UiButton Variant="Variant.Outlined"
                                   OnClick="_ => OnDeleteAccount(context)"
                                   Color="Color.Error" StartIcon="trash">حذف</UiButton>
                    </div>
                    <div class="ui-responsive ui-mobile-only">
                        <UiIconButton aria-label="تغییر نمایش" Variant="Variant.Filled"
                                       OnClick="_ => OnDeleteAccount(context)"
                                       Color="Color.Error" Icon="trash" />
                    </div>

                </div>
            </td>
        </RowTemplate>
        <NoRecordsContent>
            <p>هیچ کاربری ثبت نشده است!</p>
        </NoRecordsContent>
        <LoadingContent>
            <p>در حال بارگیری</p>
        </LoadingContent>

    </UiTable>
</AccountShell>
