@attribute [Route(ClientRoutes.UserAccounts.AccountsList)]
@attribute [Authorize(Roles = BuiltinRoles.Administrators)]
@using Mkx.Templates.Shared.DTOs.UserAccounts
@inherits AppComponentBase

<PageTitle>مدیریت کاربران</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudBreadcrumbs Class="px-0" Items="_breadcrumbs" MaxItems="2">
        <SeparatorTemplate>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
        </SeparatorTemplate>
    </MudBreadcrumbs>

    <div class="flex-column gap-2 align-center justify-content-center w-100 mb-6 d-md-flex d-none">
        <MudText Typo="Typo.h4">مدیریت کاربران</MudText>
    </div>

    <MudTable @ref="_table" T="GetUserAccountResponse" ServerData="LoadUsersAsync" Hover ContainerClass="responsive-table-paginated"
              Breakpoint="Breakpoint.Xs" Elevation="24" Dense Class="glassy-card" RowsPerPage="RowsPerPage">
        <ToolBarContent>
            <MudTextField T="string" Clearable="true" Immediate="true" Value="@_searchString" ValueChanged="OnSearch" DebounceInterval="500"
                          Placeholder="جستجو بر اساس نام، نام کاربری و شماره تلفن ..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"></MudTextField>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudIconButton Size="Size.Small" Variant="Variant.Filled"
                               OnClick="OnAddAccount" Class="me-2"
                               Color="Color.Primary" Icon="@Icons.Material.Outlined.Add" />
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled"
                           OnClick="OnAddAccount" Class="me-2"
                           Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">کاربر جدید</MudButton>
            </MudHidden>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>نام کاربری</MudTh>
            <MudTh>نام و نام خانوادگی</MudTh>
            <MudTh>شماره تماس</MudTh>
            <MudTh>نقش</MudTh>
            <MudTh>عملیات</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="نام کاربری">@context.Username</MudTd>
            <MudTd DataLabel="نام و نام خانوادگی">@context.FullName</MudTd>
            <MudTd DataLabel="شماره تماس">@(string.IsNullOrEmpty(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
            <MudTd DataLabel="نقش">@context.Role.GetRoleName()</MudTd>
            <MudTd DataLabel="عملیات">
                <div class="d-flex gap-2">
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="_ => OnEditAccount(context)"
                                   Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit">ویرایش</MudButton>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudIconButton Size="Size.Small" Variant="Variant.Filled"
                                       OnClick="_ => OnEditAccount(context)"
                                       Color="Color.Info" Icon="@Icons.Material.Filled.Edit" />
                    </MudHidden>

                    @if (context.IsActive)
                    {
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Lock"
                                       Color="Color.Warning" Variant="Variant.Outlined"
                                       OnClick="@(() => LockUser(context))">غیرفعال سازی</MudButton>
                        </MudHidden>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Lock"
                                           Color="Color.Warning" Variant="Variant.Filled"
                                           OnClick="@(() => LockUser(context))" />
                        </MudHidden>

                    }
                    else
                    {
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.LockOpen"
                                       Color="Color.Success" Variant="Variant.Outlined"
                                       OnClick="@(() => UnlockUser(context))">فعالسازی</MudButton>
                        </MudHidden>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.LockOpen"
                                           Color="Color.Success" Variant="Variant.Filled"
                                           OnClick="@(() => UnlockUser(context))" />
                        </MudHidden>
                    }
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="_ => OnDeleteAccount(context)"
                                   Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">حذف</MudButton>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudIconButton Size="Size.Small" Variant="Variant.Filled"
                                       OnClick="_ => OnDeleteAccount(context)"
                                       Color="Color.Error" Icon="@Icons.Material.Filled.Delete" />
                    </MudHidden>

                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>هیچ کاربری ثبت نشده است!</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>در حال بارگیری</MudText>
        </LoadingContent>
        <PagerContent>
            <div class="d-flex flex-column flex-md-row align-center justify-md-space-between w-100 py-4" style="gap: 1rem;">
                <div class="mud-table-pagination-caption">
                    @InfoText
                </div>
                <MudPagination SelectedChanged="PageChanged"
                               Selected="@(_currentPage + 1)"
                               Color="Color.Primary"
                               Count="@PageCount"
                               Class="justify-center"
                               BoundaryCount="1"
                               MiddleCount="3" />
                <div class="d-none d-md-block mud-table-pagination-caption" style="visibility: hidden; pointer-events: none;">
                    @InfoText
                </div>
            </div>
        </PagerContent>
    </MudTable>
</MudContainer>