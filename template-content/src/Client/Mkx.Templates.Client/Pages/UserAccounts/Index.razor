@attribute [Route(ClientRoutes.UserAccounts.Index)]
@attribute [Authorize]
@using Mkx.Templates.Client.Pages.UserAccounts.Components
@inherits AppComponentBase

<PageTitle>حساب کاربری من</PageTitle>
<AccountShell Eyebrow="حساب شخصی" ShowBreadcrumb="false" Title="حساب کاربری من" Description="مشخصات فردی، روش‌های ورود و امنیت حساب خود را یکجا مدیریت کنید.">
    <div class="account-overview">
        <UserProfileCard />
        <section class="account-panel">
            <div class="account-panel-head"><div><h2>امنیت و روش‌های ورود</h2><p>برای ورود ایمن‌تر از رمز دومرحله‌ای و کلید عبور استفاده کنید.</p></div></div>
            <div class="account-tiles">
                <ActionCard Title="تغییر رمز عبور" Description="مدیریت رمز عبور و امنیت حساب" StartIcon="key" OnClick="ChangePassword" />
                <ActionCard Title="ورود دومرحله‌ای" Description="افزایش امنیت با برنامه رمزساز" StartIcon="check" Href="@ClientRoutes.UserAccounts.TwoFactorAuthentication" />
                <ActionCard Title="حساب‌های متصل" Description="مدیریت سرویس‌های ورود خارجی" StartIcon="users" Href="@ClientRoutes.UserAccounts.ExternalLogins" />
                <ActionCard Title="کلیدهای عبور" Description="ورود ایمن با ویژگی‌های دستگاه" StartIcon="fingerprint" Href="@ClientRoutes.UserAccounts.Passkeys" />
            </div>
            <AuthorizeView Roles="@BuiltinRoles.Administrators"><div class="account-admin-links"><a href="@ClientRoutes.Users.Index" class="ui-button ui-button-outlined"><UiIcon Icon="users" />مدیریت کاربران</a><a href="@ClientRoutes.Users.RoleClaims" class="ui-button ui-button-outlined"><UiIcon Icon="key" />دسترسی نقش‌ها</a></div></AuthorizeView>
        </section>
        <section class="account-panel account-signout"><div class="account-panel-head"><div><h2>خروج از حساب</h2><p>برای پایان دادن به نشست فعلی و جلوگیری از دسترسی دیگران، از حساب خارج شوید.</p></div></div><LogoutControl /></section>
    </div>
</AccountShell>
