@attribute [Route(ClientRoutes.UserAccounts.Passkeys)]
@attribute [Authorize]
@inherits AppComponentBase
<PageTitle>کلیدهای عبور</PageTitle>
<AccountShell Title="کلیدهای عبور" Description="با اثر انگشت، چهره یا PIN دستگاه وارد حساب خود شوید." BackHref="@ClientRoutes.UserAccounts.Index" BackLabel="حساب من">
    <Actions><UiButton Variant="Variant.Filled" StartIcon="plus" OnClick="AddNewPasskey" Disabled="IsBusy">افزودن کلید عبور</UiButton></Actions>
    <ChildContent><section class="account-panel"><header class="account-panel-head"><div><h2>دستگاه‌های قابل اعتماد</h2><p>کلیدهای ثبت‌شده برای ورود به حساب شما</p></div><UiIcon Icon="fingerprint" /></header>
        @if (_passkeys is null)
        { @if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError</div> } else { <span class="ui-spinner" role="status" aria-label="دریافت کلیدها"></span> } }
        else if (_passkeys.Count == 0)
        { <div class="account-empty"><UiIcon Icon="fingerprint" /><h3>هنوز کلید عبوری ندارید</h3><p>اولین کلید را روی دستگاه شخصی خود اضافه کنید.</p></div> }
        else
        {
            @foreach (var pk in _passkeys)
            { <div class="account-detail-row"><div class="d-flex gap-3 align-center"><span class="action-symbol"><UiIcon Icon="fingerprint" /></span><div><strong>@pk.Name</strong><small>کلید عبور دستگاه</small></div></div><UiIconButton Icon="trash" Color="Color.Error" aria-label="@($"حذف کلید {pk.Name}")" OnClick="@(() => RemovePasskey(pk))" Disabled="IsBusy" /></div> }
        }
    </section></ChildContent>
</AccountShell>
