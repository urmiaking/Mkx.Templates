@attribute [Route(ClientRoutes.UserAccounts.TwoFactorAuthentication)]
@attribute [Authorize]
@inherits AppComponentBase

<PageTitle>رمز دو مرحله ای</PageTitle>

<AccountShell Title="ورود دو مرحله‌ای" Description="برای ورود امن‌تر، کد برنامه رمزساز را به حساب خود اضافه کنید." BackHref="@ClientRoutes.UserAccounts.Index" BackLabel="حساب من">
    <section class="account-panel"><header class="account-panel-head"><div><h2>امنیت ورود</h2><p>وضعیت رمزساز و روش‌های بازیابی حساب</p></div><UiIcon Icon="security" /></header>
    @if (TwoFactorAuthStatus is not null)
    {
        @if (TwoFactorAuthStatus.Enabled)
        {
            <div class="ui-alert mb-6 ui-alert-success">
                <p>احراز هویت دو مرحله ای حساب شما فعال می باشد</p>
            </div>

            @if (TwoFactorAuthStatus.RecoveryCodesLeft is <= 3 and > 0)
            {
                <div class="ui-alert mb-6 ui-alert-info">
                    <p>
                        شما تنها @TwoFactorAuthStatus.RecoveryCodesLeft کد بازیابی استفاده نشده دارید.
                        برای تولید کدهای بازیابی بیشتر <a class="ui-color-info" href="@ClientRoutes.UserAccounts.GenerateRecoveryCodes">اینجا</a> را کلیک کنید
                    </p>
                </div>
            }
            else if (TwoFactorAuthStatus.RecoveryCodesLeft == 0)
            {
                <div class="ui-alert mb-6 ui-alert-error">
                    <p>
                        تمامی کدهای بازیابی رمز دو مرحله ای حساب شما مصرف شده اند
                        برای تولید کدهای بازیابی جدید <a class="ui-color-info" href="@ClientRoutes.UserAccounts.GenerateRecoveryCodes">اینجا</a> را کلیک کنید
                    </p>
                </div>
            }

        }
        else
        {
            <div class="ui-alert mb-6 ui-alert-error">
                <p>احراز هویت دو مرحله ای برای حساب شما فعال نمی باشد</p>
            </div>
        }

        <div class="account-tiles">
            @if (TwoFactorAuthStatus.Enabled)
            {
                @if (TwoFactorAuthStatus.MachineRemembered)
                {
                    <div>
                        <ActionCard Title="فراموشی این دستگاه"
                                       Description="حذف قابلیت دور زدن رمز دو مرحله ای در این دستگاه"
                                       StartIcon="trash"
                                       OnClick="OnForgetBrowser" />
                    </div>
                }

                <div>
                    <ActionCard Title="تولید کدهای بازیابی"
                                   Description="بازنشانی و تولید کدهای بازیابی جدید"
                                   StartIcon="key"
                                   Href="@ClientRoutes.UserAccounts.GenerateRecoveryCodes" />
                </div>
                <div>
                    <ActionCard Title="بازنشانی رمز دو مرحله ای"
                                   Description="ریسیت کردن تنظیمات رمز دو مرحله ای"
                                   StartIcon="key"
                                   Href="@ClientRoutes.UserAccounts.ResetAuthenticator" />
                </div>
                <div>
                    <ActionCard Title="غیرفعال سازی"
                                   Description="غیرفعال سازی احراز هویت دو مرحله ای"
                                   StartIcon="lock"
                                   OnClick="OnDisable2Fa" />
                </div>
            }
            else
            {
                <div>
                    <ActionCard Title="فعال سازی"
                                   Description="فعال سازی احراز هویت دو مرحله ای"
                                   StartIcon="check"
                                   Href="@ClientRoutes.UserAccounts.EnableAuthenticator" />
                </div>
            }
        </div>
    }
    else if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError</div> }
    else { <span class="ui-spinner" role="status" aria-label="دریافت وضعیت امنیت"></span> }
</section></AccountShell>
