@inherits AppComponentBase
<EditForm Model="_model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <UiDialog>
        <DialogContent>
            <div class="account-edit-help"><UiIcon Icon="lock" /><p>رمزی طولانی و منحصربه‌فرد انتخاب کنید که در سرویس دیگری استفاده نکرده‌اید.</p></div>
            <div class="identity-form">
                <UiTextField @bind-Value="_model.Password" For="@(() => _model.Password)" InputType="InputType.Password" Label="@_model.GetDisplayName(() => _model.Password)" autocomplete="current-password" dir="ltr" Disabled="IsBusy" />
                <UiTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)" InputType="InputType.Password" Label="@_model.GetDisplayName(() => _model.NewPassword)" autocomplete="new-password" dir="ltr" Disabled="IsBusy" />
                <UiTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)" InputType="InputType.Password" Label="@_model.GetDisplayName(() => _model.ConfirmPassword)" autocomplete="new-password" dir="ltr" Disabled="IsBusy" />
            </div>
        </DialogContent>
        <DialogActions>
            <UiButton OnClick="Close" Disabled="IsBusy">انصراف</UiButton>
            <UiButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="IsBusy">@if (IsBusy) { <span class="ui-spinner" aria-hidden="true"></span> } ذخیره رمز عبور</UiButton>
        </DialogActions>
    </UiDialog>
</EditForm>
