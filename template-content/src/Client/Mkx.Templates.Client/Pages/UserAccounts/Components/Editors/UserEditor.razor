@inherits AppComponentBase

<UiForm Model="@Model" @ref="@_form" Validation="@(_userValidator.ValidateValue)">
    <UiDialog>
        <DialogContent>
            <div class="ui-grid">
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiTextField @bind-Value="Model.FullName"
                                  For="@(() => Model.FullName)"
                                  Label="@Model.GetDisplayName(() => Model.FullName)" />
                </div>
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiTextField @bind-Value="Model.PhoneNumber"
                                  For="@(() => Model.PhoneNumber)"
                                  Label="@Model.GetDisplayName(() => Model.PhoneNumber)" />
                </div>
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiTextField @bind-Value="Model.Username"
                                  For="@(() => Model.Username)"
                                  Label="@Model.GetDisplayName(() => Model.Username)" />
                </div>
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiTextField @bind-Value="Model.Email"
                                  For="@(() => Model.Email)"
                                  Label="@Model.GetDisplayName(() => Model.Email)" />
                </div>
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiTextField @bind-Value="Model.Password"
                                  For="@(() => Model.Password)"
                                  Label="@Model.GetDisplayName(() => Model.Password)"
                                  InputType="InputType.Password" />
                </div>
                <div class="ui-cell ui-xs-12 ui-md-6 ui-lg-4">
                    <UiSelect T="string?"
                               @bind-Value="Model.Role"
                               Label="@Model.GetDisplayName(() => Model.Role)"
                               For="() => Model.Role">
                        @foreach (var item in BuiltinRoles.Roles)
                        {
                            <UiSelectItem Value="@item">@item.GetRoleName()</UiSelectItem>
                        }
                    </UiSelect>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <UiButton Color="Color.Error"
                       OnClick="Close"
                       StartIcon="close"
                       Variant="Variant.Filled">انصراف</UiButton>

            <UiButton Class="m-2"
                       Color="Color.Primary"
                       Disabled="@IsBusy"
                       StartIcon="check"
                       OnClick="@(async () => await Submit())"
                       Variant="Variant.Filled">
                @if (IsBusy)
                {
                    <span class="ui-spinner ms-n1" role="status" aria-label="در حال بارگذاری"></span>
                    <p class="ms-2">
                        در حال ذخیره
                    </p>
                }
                else
                {
                    <p>ذخیره</p>
                }
            </UiButton>
        </DialogActions>
    </UiDialog>
</UiForm>
