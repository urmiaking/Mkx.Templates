@inherits AppComponentBase
<UiForm Model="this" @ref="_form">
    <UiDialog>
        <DialogContent>
            <div class="account-edit-help"><UiIcon Icon="user" /><p>این نام در پروفایل و بخش‌های مختلف سامانه نمایش داده می‌شود.</p></div>
            <UiTextField @bind-Value="FullName" For="@(() => FullName)" Label="نام و نام خانوادگی" autocomplete="name" Required="true" Disabled="IsBusy" />
        </DialogContent>
        <DialogActions>
            <UiButton OnClick="Close" Disabled="IsBusy">انصراف</UiButton>
            <UiButton Variant="Variant.Filled" Disabled="IsBusy" OnClick="Submit">@if (IsBusy) { <span class="ui-spinner" aria-hidden="true"></span> } ذخیره تغییرات</UiButton>
        </DialogActions>
    </UiDialog>
</UiForm>
