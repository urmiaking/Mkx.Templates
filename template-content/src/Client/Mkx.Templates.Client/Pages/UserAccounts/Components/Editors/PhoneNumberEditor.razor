@inherits AppComponentBase
<UiForm Model="this" @ref="_form">
    <UiDialog>
        <DialogContent>
            <div class="account-edit-help"><UiIcon Icon="security" /><p>برای تغییر شماره، کد تأیید به شمارهٔ فعلی شما ارسال می‌شود. شمارهٔ جدید را وارد کنید و سپس کد را بنویسید.</p></div>
            <UiTextField @bind-Value="PhoneNumber" For="@(() => PhoneNumber)" Label="شماره همراه جدید" InputType="InputType.Telephone" dir="ltr" Required="true" Disabled="IsBusy" />
            @if (_tokenSent)
            {
                <div class="mt-5"><UiOtpField @bind-Value="_token" Disabled="IsBusy" Hint="کد به شمارهٔ فعلی حساب شما ارسال شده است." /></div>
                <UiButton Class="mt-3" Disabled="@(IsBusy || _sendTokenDisabled)" OnClick="SendToken">@(_sendTokenDisabled ? $"ارسال مجدد در {_otpRemaining / 60:00}:{_otpRemaining % 60:00}" : "ارسال مجدد کد")</UiButton>
            }
            else
            {
                <UiButton Class="mt-4" Variant="Variant.Outlined" OnClick="SendToken" StartIcon="phone" Disabled="@(IsBusy || !PhoneNumberChanged || PhoneNumber.Length != 11)">دریافت کد تأیید</UiButton>
            }
        </DialogContent>
        <DialogActions>
            <UiButton OnClick="Close" Disabled="IsBusy">انصراف</UiButton>
            <UiButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(IsBusy || !PhoneNumberChanged || _token?.Length != 6)" OnClick="Submit">
                @if (IsBusy) { <span class="ui-spinner" aria-hidden="true"></span> }
                ذخیره شماره
            </UiButton>
        </DialogActions>
    </UiDialog>
</UiForm>
