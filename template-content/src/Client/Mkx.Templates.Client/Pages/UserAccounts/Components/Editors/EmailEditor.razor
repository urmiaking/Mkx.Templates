@inherits AppComponentBase
<UiForm Model="this" @ref="_form">
    <UiDialog>
        <DialogContent>
            <div class="account-edit-help"><UiIcon Icon="mail" /><p>ایمیل حساب خود را به‌روز کنید تا اطلاعات تماس شما همیشه در دسترس باشد.</p></div>
            <UiTextField @bind-Value="Email" For="@(() => Email)" Label="نشانی ایمیل" InputType="InputType.Email" autocomplete="email" dir="ltr" Disabled="IsBusy" />
        </DialogContent>
        <DialogActions>
            <UiButton OnClick="Close" Disabled="IsBusy">انصراف</UiButton>
            <UiButton Variant="Variant.Filled" Disabled="IsBusy" OnClick="Submit">@if (IsBusy) { <span class="ui-spinner" aria-hidden="true"></span> } ذخیره تغییرات</UiButton>
        </DialogActions>
    </UiDialog>
</UiForm>
