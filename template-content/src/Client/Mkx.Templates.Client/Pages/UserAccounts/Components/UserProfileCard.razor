@inherits AppComponentBase
<section class="account-panel account-profile">
    <div class="account-panel-head"><h2>اطلاعات پروفایل</h2><span class="ui-chip">حساب شخصی</span></div>
    @if (UserInfo is null)
    {
        @if (LastRequestError is not null) { <div class="ui-alert ui-alert-error" role="alert">@LastRequestError<UiButton OnClick="LoadUserInfoAsync" Disabled="IsBusy">تلاش دوباره</UiButton></div> }
        else { <div class="account-empty" role="status"><UiIcon Icon="clock" /><strong>در حال بارگذاری پروفایل…</strong></div> }
    }
    else
    {
        <div class="account-profile-header"><span class="ui-avatar">@Mkx.Templates.Sdk.Shared.Extensions.StringExtensions.GetInitialsWithPeriods(UserInfo.FullName)</span><div><strong>@UserInfo.FullName</strong><small>@UserInfo.Role.GetRoleName()</small></div></div>
        <div class="account-detail-row"><div><small>نام کاربری</small><strong dir="ltr">@UserInfo.Username</strong></div></div>
        <div class="account-detail-row"><div><small>نام و نام خانوادگی</small><strong>@UserInfo.FullName</strong></div><UiIconButton Icon="edit" aria-label="ویرایش نام" OnClick="ChangeFullName" /></div>
        <div class="account-detail-row"><div><small>شماره همراه</small><strong dir="ltr">@(UserInfo.PhoneNumber ?? "ثبت نشده")</strong></div><UiIconButton Icon="edit" aria-label="تغییر شماره همراه" OnClick="ChangePhoneNumber" /></div>
        <div class="account-detail-row"><div><small>نشانی ایمیل</small><strong dir="ltr">@(UserInfo.Email ?? "ثبت نشده")</strong></div><UiIconButton Icon="edit" aria-label="تغییر ایمیل" OnClick="ChangeEmail" /></div>
    }
</section>
