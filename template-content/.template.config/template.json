{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mkx",
  "classifications": [
    "Common",
    "Blazor"
  ],
  "identity": "Mkx.Templates.Blazor",
  "name": "Mkx Blazor Solution Template",
  "shortName": "mkx-blazor",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Mkx.Templates",
  "guids": [
    "3cb26e0d-a6a9-4679-b220-676bb6eea2ce"
  ],
  "preferNameDirectory": false,
  "symbols": {
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the tested SampleItem CRUD reference (domain, API, UI and sample-specific tests)."
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "7007"
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "7006"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!IncludeSample)",
          "exclude": [
            "src/**/SampleItemAggregate/**",
            "src/**/SampleItems/**",
            "src/**/SampleItem*.cs",
            "src/**/ISampleItem*.cs",
            "src/**/SampleItems.razor",
            "src/**/Migrations/20260930190627_TestCrudConcurrency*.cs"
          ]
        }
      ],
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/TestResults/**",
        "**/.vs/**",
        "**/.git/**",
        "**/node_modules/**",
        "**/artifacts/**",
        "**/*.user",
        "**/*.pfx",
        "**/*.log",
        "**/appsettings.Local.json",
        "**/appsettings.Push.local.json",
        "**/.env",
        "**/.env.*"
      ]
    },
    {
      "source": "./",
      "target": "./",
      "include": [
        ".env.example"
      ],
      "exclude": []
    }
  ]
}