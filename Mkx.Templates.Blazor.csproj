<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Mkx.Templates.Blazor</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Mkx Blazor Solution Template</Title>
    <Authors>Mkx</Authors>
    <Description>Visual Studio / dotnet new template for a Blazor solution using .NET 10 and .slnx.</Description>
    <PackageTags>dotnet-new;templates;blazor;slnx;net10</PackageTags>
    
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Template scripts are content, not install hooks; templates intentionally have no lib/ref output. -->
    <NoWarn>$(NoWarn);NU5110;NU5111;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <!-- Include all files in template-content/ under content/ in the nuget package -->
    <Content Include="template-content\**\*" Exclude="template-content\**\bin\**;template-content\**\obj\**;template-content\**\TestResults\**;template-content\**\.vs\**;template-content\**\.git\**;template-content\**\node_modules\**;template-content\**\artifacts\**;template-content\**\*.user;template-content\**\*.pfx;template-content\**\*.log;template-content\**\appsettings.Local.json;template-content\**\.env;template-content\**\.env.*" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="template-content\.env.example" PackagePath="content/.env.example" />
    
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
